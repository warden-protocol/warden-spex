.PHONY: run dev build clean test demo install help

# Default target
.DEFAULT_GOAL := help

help:
	@echo "SPEX TypeScript Implementation - Available targets:"
	@echo "  run      - Run the SPEX demo application"
	@echo "  dev      - Run in development mode with hot reloading"
	@echo "  build    - Build the TypeScript project"
	@echo "  clean    - Clean build artifacts"
	@echo "  test     - Run tests"
	@echo "  demo     - Run the SPEX Blossom demo"
	@echo "  install  - Install dependencies"
	@echo "  help     - Show this help message"

# Run the SPEX demo application
run:
	npm start

# Run in development mode with hot reloading
dev:
	npm run dev

# Build the project
build:
	npm run build

# Clean build artifacts
clean:
	npm run clean

# Run tests
test:
	npm test

# Run the SPEX demo
demo:
	npm run demo

# Install dependencies
install:
	npm install
